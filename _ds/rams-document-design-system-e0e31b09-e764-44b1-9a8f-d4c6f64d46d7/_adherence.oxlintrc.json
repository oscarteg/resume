{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "shadcn/**",
              "ui_kits/personal-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|variant|arrow|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, href, onClick, variant, arrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|ghost|solid)$/]",
        "message": "<Button> variant must be one of 'link' | 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, href, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|accent|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, color, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|title|subtitle|meta|href|lastBorder|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: left, title, subtitle, meta, href, lastBorder."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pipeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|activeIndex|key|ref|className|style|children)$/]",
        "message": "<Pipeline> doesn't accept that prop. Declared props: steps, activeIndex."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|index|active|key|ref|className|style|children)$/]",
        "message": "<RailNavItem> doesn't accept that prop. Declared props: label, href, index, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeaderAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<SectionHeaderAction> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<SkillColumn> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|showDot|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: label, showDot."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "Card": {
        "replaces": []
      },
      "Kicker": {
        "replaces": []
